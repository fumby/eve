# Copy to .env and fill in. .env is git-ignored — keys never go in code.
# On a server, copy this file over the private network (never through chat or git).
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
VOYAGE_API_KEY=
# Fine-grained, read-only: the repo watch only ever reads.
GITHUB_TOKEN=
# Ledger (query_ledger tool): Postgres DSN for the SELECT-only role, via the
# IPv4 shared transaction pooler. Anatomy — the user is trillion_analytics.<ref>
# (never postgres.<ref>), the host ends in pooler.supabase.com (never
# db.<ref>.supabase.co, which is IPv6-only), the port is 6543. Quote the value;
# pick an alphanumeric password so nothing needs percent-encoding.
# SUPABASE_LEDGER_URL="postgresql://trillion_analytics.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
SUPABASE_LEDGER_URL=
# Head of design, optional: Gemini image generation for mockups (image models
# need BILLING enabled on the AI Studio project — the free tier rejects them).
# Absent = the design agent composes everything in TSX, no images.
# GEMINI_API_KEY=
# Optional: embeddings fallback when VOYAGE_API_KEY is unset.
# OPENAI_API_KEY=
# Optional: perplexity_search tool (fast sourced web answers via Sonar).
# Absent = the tool just isn't available; deep_research still works either way.
# PERPLEXITY_API_KEY=
# Not a key, but a server needs it in the service unit (not here):
# TZ=Europe/Rome — heartbeat times, quiet hours and reminders are local wall clock.
