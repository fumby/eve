{
  "name": "eve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EVE — a voice-first personal AI assistant",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "eve": "tsx src/cli.ts",
    "voice": "tsx src/cli.ts --voice",
    "brief": "tsx scripts/brief-now.ts",
    "voicecheck": "tsx scripts/voice-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "EVE_STATE_DIR=$(mktemp -d) node --import tsx --test \"tests/**/*.test.ts\"",
    "sttcheck": "tsx scripts/stt-live-check.ts",
    "ledgercheck": "tsx scripts/ledger-check.ts",
    "face": "tsx src/face/server.ts",
    "face:sandbox": "EVE_STATE_DIR=$(mktemp -d) tsx src/face/server.ts --no-open",
    "designcheck": "tsx scripts/design-composer-check.ts",
    "design": "tsx scripts/design-dispatch.ts",
    "groundtruth": "tsx scripts/ground-truth.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/genai": "^2.17.1",
    "@picovoice/pvrecorder-node": "^1.2.9",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
